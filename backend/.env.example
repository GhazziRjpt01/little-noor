# Copy this file to backend/.env and replace the placeholders.
# These values are not real keys. Do not put a service-role key here or in the frontend.
# This API uses the anon key with the parent's access token so Row Level Security stays in force.

PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# OpenAI is read only by this API process.
# Put the secret in backend/.env. Do not put it in the frontend, Vite, or git.
# Leave the key empty until you want the teacher connected. The API still starts.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
# coral is the warm voice used when the teacher speaks a chat reply.
OPENAI_TEACHER_VOICE=coral
OPENAI_TIMEOUT_MS=12000
